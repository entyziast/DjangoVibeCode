# Скопируйте этот файл в .env и заполните оба пустых значения своими секретами.
# Используйте разные случайные значения. Не публикуйте .env.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Настройки только для локальной лабораторной работы.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=exam_prep
POSTGRES_USER=exam_prep
WEB_PORT=8000
